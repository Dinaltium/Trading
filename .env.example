# Copy this file to .env and fill in real values. Never commit .env itself.

# Alpaca paper trading — https://alpaca.markets (dashboard → API Keys, paper account)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Groq — free, fast open-model inference. This is the LIVE reasoning engine (only
# provider whose decisions actually execute trades). https://console.groq.com
GROQ_API_KEY=

# Featherless AI — free-tier open-model inference. Shadow model only, never executes.
# https://featherless.ai
FEATHER_API_KEY=

# Mistral — shadow model only, never executes. Optional; the loop runs fine without it,
# that provider just reports "key not set" in the audit log until added.
# https://console.mistral.ai
MISTRAL_API_KEY=
